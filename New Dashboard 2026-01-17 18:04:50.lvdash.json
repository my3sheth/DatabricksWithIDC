{
  "datasets": [
    {
      "name": "48e4785e",
      "displayName": "Daily Sales Revenue Report",
      "queryLines": [
        "SELECT\r\n",
        "  DATE(event_time) AS event_date,\r\n",
        "  SUM(price) AS daily_revenue\r\n",
        "FROM workspace.ecommerce.delta_events\r\n",
        "WHERE event_type = 'purchase'\r\n",
        "GROUP BY event_date\r\n",
        "ORDER BY event_date;\r\n"
      ],
      "catalog": "workspace",
      "schema": "ecommerce"
    },
    {
      "name": "ac2a0fcc",
      "displayName": "Products",
      "queryLines": [
        "SELECT\r\n",
        "  product_id,\r\n",
        "  SUM(price) AS revenue\r\n",
        "FROM workspace.ecommerce.delta_events\r\n",
        "WHERE event_type = 'purchase'\r\n",
        "GROUP BY product_id\r\n",
        "ORDER BY revenue DESC\r\n",
        "LIMIT 10;\r\n"
      ]
    },
    {
      "name": "fce52a3f",
      "displayName": "Users over Events",
      "queryLines": [
        "SELECT\r\n",
        "  event_type,\r\n",
        "  COUNT(DISTINCT user_id) AS users\r\n",
        "FROM workspace.ecommerce.delta_events\r\n",
        "WHERE event_type IN ('view','cart','purchase')\r\n",
        "GROUP BY event_type;\r\n"
      ]
    }
  ],
